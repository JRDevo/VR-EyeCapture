// Version information resource (generated from cmake/version.rc.in by eye_add_version_info in CMakeLists.txt).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @EYE_RC_VER_COMMA@
 PRODUCTVERSION @EYE_RC_VER_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @EYE_RC_FILETYPE@
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "JRDevo"
            VALUE "FileDescription", "@EYE_RC_DESC@"
            VALUE "FileVersion", "@EYE_RC_VER_DOT@"
            VALUE "InternalName", "@EYE_RC_INTERNAL@"
            VALUE "LegalCopyright", "Copyright (c) 2026 JRDevo"
            VALUE "OriginalFilename", "@EYE_RC_ORIGINAL@"
            VALUE "ProductName", "VR EyeCapture"
            VALUE "ProductVersion", "@EYE_RC_VER_DOT@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
